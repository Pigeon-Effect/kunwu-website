---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asset, htmlLang, locales, switchLangPath, useT, type Lang, type RouteKey } from '../i18n/utils';
import type { PaintingKey } from '../data/paintings';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** which nav item is active */
  route?: RouteKey;
  /** the painting excerpts this page shows – credited in the footer */
  paintings?: PaintingKey[];
}

const { lang, title, description, route, paintings = [] } = Astro.props;
const t = useT(lang);
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
const alternate = (l: Lang) => new URL(switchLangPath(pathname, l), Astro.site).href;
const ogImage = new URL(asset('og-image.jpg'), Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={alternate(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alternate('en')} />

    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <meta name="theme-color" content="#4c4639" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <!-- Marks JS as available before first paint, so .reveal elements never flash. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-[70] bg-ink px-4 py-2 text-rice focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{t.nav.skip}</a
    >
    <Header lang={lang} route={route} />
    <main id="main" class="flex-1 pt-[4.5rem]" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} paintings={paintings} />

    <script>
      // The header (the scroll's mounting) slides away while the page scrolls down and comes back the
      // moment it scrolls up. It stays while the menu is open, near the top, and while it has focus.
      const header = document.querySelector<HTMLElement>('[data-header]');
      const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
      if (header) {
        let lastY = Math.max(0, window.scrollY);
        let queued = false;
        const set = (hidden: boolean) => header.toggleAttribute('data-hidden', hidden);
        const update = () => {
          queued = false;
          const y = Math.max(0, window.scrollY);
          const dy = y - lastY;
          lastY = y;
          if (menu?.open || y < header.offsetHeight || header.contains(document.activeElement)) set(false);
          else if (dy > 3) set(true);
          else if (dy < 0) set(false);
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        header.addEventListener('focusin', () => set(false));
        menu?.addEventListener('toggle', () => menu.open && set(false));
      }

      // Mobile menu: close after choosing an item and on Escape.
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });

      // Calligraphy ink and paintings below the first screen load when they come near it – not during
      // the first page load, so what is in view gets the bandwidth. A painting settles in like ink.
      const loadInk = (el: Element) =>
        el.querySelectorAll<SVGImageElement>('image[data-href]').forEach((img) => img.setAttribute('href', img.dataset.href!));
      const loadPainting = (pic: Element) => {
        pic.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((s) => (s.srcset = s.dataset.srcset!));
        const img = pic.querySelector<HTMLImageElement>('img[data-src]');
        if (!img) return;
        img.addEventListener('load', () => img.classList.add('ink-in'), { once: true });
        img.srcset = img.dataset.srcset!;
        img.src = img.dataset.src!;
      };
      const deferred = [...document.querySelectorAll('.write[data-lazy], picture[data-defer] > img')];
      const load = (el: Element) => (el.matches('img') ? loadPainting(el.parentElement!) : loadInk(el));
      if ('IntersectionObserver' in window) {
        const near = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                load(entry.target);
                near.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '500px 0px' },
        );
        deferred.forEach((el) => near.observe(el));
      } else {
        deferred.forEach(load);
      }

      // Reveal on scroll: fade/translate in once; calligraphy (.write) starts writing. Without
      // IntersectionObserver everything shows.
      const items = document.querySelectorAll<HTMLElement>('.reveal, .write');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
