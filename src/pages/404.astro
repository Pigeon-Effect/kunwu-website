---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Calligraphy from '../components/Calligraphy.astro';
import { sections } from '../config/sections';
import { localePath, useT } from '../i18n/utils';

const en = useT('en');
const zh = useT('zh');
---

<Base lang="en" title={en.meta.notFound.title} description={en.meta.notFound.description}>
  <section class="wrap grid min-h-[70vh] content-center gap-14 py-24 md:grid-cols-2">
    <div>
      <SectionLabel as="p" decorative lang="en" {...sections.notFound} label="404" />
      <h1 class="mt-6 text-5xl sm:text-6xl">{en.notFound.title}</h1>
      <p class="mt-5 text-ink-soft">{en.notFound.text}</p>
      <a href={localePath('en')} class="btn mt-10">{en.notFound.home}</a>
    </div>
    <div lang="zh-Hans">
      <Calligraphy text={sections.notFound.hanzi} vertical={false} size="clamp(3.4rem, 8vw, 5rem)" delay={400} eager class="-ml-2 mb-6" />
      <p class="font-display text-4xl sm:text-5xl">{zh.notFound.title}</p>
      <p class="mt-5 text-ink-soft">{zh.notFound.text}</p>
      <a href={localePath('zh')} class="btn btn-ghost mt-10">{zh.notFound.home}</a>
    </div>
  </section>
</Base>
