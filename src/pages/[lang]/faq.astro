---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getLangStaticPaths, localePath, splitId, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const topics = ['before', 'training', 'life', 'booking'] as const;

const entries = await getCollection('faq', (e) => splitId(e.id).lang === lang);
const items = await Promise.all(
  entries.map(async (e) => ({ ...e.data, slug: splitId(e.id).slug, Content: (await render(e)).Content })),
);
const byTopic = topics.map((topic) => ({
  topic,
  items: items.filter((i) => i.topic === topic).sort((a, b) => a.order - b.order),
}));
---

<Base lang={lang} title={t.meta.faq.title} description={t.meta.faq.description} route="faq">
  <PageHead title={t.faq.title} lede={t.faq.lede}>
    <nav aria-label={t.faq.title} class="mt-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {byTopic.map((g) => <li><a href={`#${g.topic}`}>{t.faq.topics[g.topic]}</a></li>)}
      </ul>
    </nav>
  </PageHead>

  <div class="wrap pb-16 sm:pb-24">
    {
      byTopic.map((group) => (
        <section id={group.topic} class="grid gap-6 border-t border-gold py-10 md:grid-cols-[16rem_1fr] md:gap-12" aria-labelledby={`${group.topic}-title`}>
          <h2 id={`${group.topic}-title`} class="text-2xl sm:text-3xl">
            {t.faq.topics[group.topic]}
          </h2>
          <div class="divide-y divide-gold-pale border-y border-gold-pale">
            {group.items.map((item) => (
              <details id={item.slug} class="group py-1">
                <summary class="flex list-none items-start justify-between gap-6 py-3.5 text-lg [&::-webkit-details-marker]:hidden">
                  <span>{item.question}</span>
                  <span
                    aria-hidden="true"
                    class="mt-2 grid h-4 w-4 shrink-0 place-items-center rounded-full border border-gold transition group-open:bg-gold"
                  />
                </summary>
                <div class="prose-kw pb-5 text-ink-soft">
                  <item.Content />
                </div>
              </details>
            ))}
          </div>
        </section>
      ))
    }
    <p class="border-t border-gold pt-10 text-lg">
      {t.faq.stillQuestions} <a href={localePath(lang, 'contact')}>{t.faq.contactLink} →</a>
    </p>
  </div>
</Base>
