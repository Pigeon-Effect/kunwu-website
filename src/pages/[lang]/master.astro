---
/**
 * /master – every visible master in full: portrait, lineage, credentials and the complete biography.
 * Data: src/data/masters.ts (Chinese texts verbatim from the school).
 */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Calligraphy from '../../components/Calligraphy.astro';
import Photo from '../../components/Photo.astro';
import Seal from '../../components/Seal.astro';
import RichText from '../../components/RichText.astro';
import MasterPortraitPending from '../../components/MasterPortraitPending.astro';
import { visibleMasters, masterPhoto } from '../../data/masters';
import { photos } from '../../data/photos';
import { getLangStaticPaths, localePath, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const zh = lang === 'zh';
---

<Base lang={lang} title={t.meta.master.title} description={t.meta.master.description} route="master">
  <PageHead lang={lang} section="masters" title={t.master.title} lede={t.master.lede}>
    <nav aria-label={t.master.title} class="mt-10">
      <ul class="flex flex-wrap gap-x-10 gap-y-3">
        {
          visibleMasters.map((m) => (
            <li>
              <a href={`#${m.slug}`} class="more">
                <span class="font-hanzi text-base tracking-[0.15em] normal-case" lang="zh-Hans">
                  {m.hanzi}
                </span>
                {!zh && <span>{m.name.en}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHead>

  {
    visibleMasters.map((m) => {
      const portrait = masterPhoto(m.image);
      const notes = m.footnotes?.[lang] ?? {};
      return (
        <article id={m.slug} class="scroll-mt-24 border-t border-ink/10 py-20 sm:py-28" aria-labelledby={`${m.slug}-name`}>
          <div class="wrap grid gap-14 lg:grid-cols-[minmax(0,25rem)_minmax(0,1fr)] lg:gap-24">
            <!-- portrait + further photos -->
            <div class="lg:sticky lg:top-28 lg:self-start">
              <div class="relative max-w-[25rem]">
                {portrait ? (
                  <Photo
                    src={portrait.src}
                    alt={portrait.alt[lang]}
                    ratio="4/5"
                    class="mount"
                    position={m.imagePosition}
                    aged
                    sizes="(min-width: 64rem) 25rem, (min-width: 26rem) 25rem, calc(100vw - 2.5rem)"
                    widths={[400, 600, 800, 1000, 1400, 1800]}
                  />
                ) : (
                  <MasterPortraitPending master={m} lang={lang} />
                )}
                <Seal text={m.seal} size="md" class="absolute -right-3 -bottom-3 sm:-right-4 sm:-bottom-4" />
              </div>
              {m.photos && m.photos.length > 0 && (
                <div class="mt-10 grid max-w-[25rem] grid-cols-2 gap-3">
                  {m.photos.map((id) => (
                    <Photo
                      src={photos[id].src}
                      alt={photos[id].alt[lang]}
                      ratio="3/4"
                      aged
                      wash={0.08}
                      sizes="12rem"
                      widths={[240, 360, 480]}
                    />
                  ))}
                </div>
              )}
            </div>

            <!-- text -->
            <div class="min-w-0">
              <header>
                <h2 id={`${m.slug}-name`}>
                  <span class="sr-only" lang="zh-Hans">{m.hanzi}</span>
                  <Calligraphy text={m.hanzi} vertical={false} size="clamp(3.4rem, 10vw, 5.8rem)" gap="0.02em" speed={1.3} class="-ml-2" />
                  {!zh && <span class="mt-4 block text-[2rem] sm:text-4xl">{m.name.en}</span>}
                </h2>
                <p class="mt-3 text-sm tracking-[0.14em] text-ink-soft">
                  <span lang="zh-Latn-pinyin">{m.name_pinyin}</span>
                  {m.layman_name[lang] && (
                    <>
                      <span aria-hidden="true" class="mx-3">·</span>
                      {t.master.laymanName}
                      {zh ? '：' : ' '}
                      {m.layman_name[lang]}
                    </>
                  )}
                </p>
                <p class="mt-6 max-w-2xl text-lg">{m.lineage[lang]}</p>
                <p class="mt-1 text-ink-soft">{m.title[lang]}</p>
              </header>

              <section class="mt-12 border-y border-ink/12 py-8" aria-labelledby={`${m.slug}-credentials`}>
                <h3 id={`${m.slug}-credentials`} class="label !text-[0.72rem]">
                  {t.master.credentialsTitle}
                </h3>
                <ul class="marks mt-5">
                  {m.credentials[lang].map((c) => (
                    <li>
                      <RichText text={c} lang={lang} />
                    </li>
                  ))}
                </ul>
              </section>

              <div class="bio mt-4 max-w-[42rem]">
                {m.bio[lang].map((section) => (
                  <section class="mt-12" aria-labelledby={`${m.slug}-${section.key}`}>
                    <h3 id={`${m.slug}-${section.key}`} class="text-[1.7rem] sm:text-3xl">
                      {t.master.sections[section.key]}
                    </h3>
                    <div class="mt-5 space-y-5 text-[1.05rem] text-ink">
                      {section.blocks.map((block) =>
                        block.type === 'p' ? (
                          <p>
                            <RichText text={block.text} lang={lang} scope={m.slug} noteLabel={t.master.notes} />
                          </p>
                        ) : block.type === 'term' ? (
                          <p>
                            <span class="font-medium text-ink">{block.term}</span>
                            {zh ? '' : ' '}
                            <RichText text={block.text} lang={lang} scope={m.slug} noteLabel={t.master.notes} />
                          </p>
                        ) : (
                          <ul class:list={[block.marks === 'check' ? 'marks' : 'marks marks-quiet']}>
                            {block.items.map((item) => (
                              <li>
                                <RichText text={item} lang={lang} scope={m.slug} noteLabel={t.master.notes} />
                              </li>
                            ))}
                          </ul>
                        ),
                      )}
                    </div>
                  </section>
                ))}

                {Object.keys(notes).length > 0 && (
                  <aside class="mt-14 border-t border-ink/12 pt-6 text-sm text-ink-soft" aria-label={t.master.notes}>
                    <ol class="space-y-2">
                      {Object.entries(notes).map(([id, text]) => (
                        <li id={`fn-${m.slug}-${id}`} class="scroll-mt-28">
                          <span aria-hidden="true">* </span>
                          <RichText text={text} lang={lang} />
                          <a href={`#fnref-${m.slug}-${id}`} class="ml-2 no-underline" aria-label="↩">
                            ↩
                          </a>
                        </li>
                      ))}
                    </ol>
                  </aside>
                )}
              </div>
            </div>
          </div>
        </article>
      );
    })
  }

  <section class="border-t border-ink/10 py-20 sm:py-28">
    <div class="wrap flex flex-wrap items-center gap-x-10 gap-y-6">
      <a href={localePath(lang, 'book')} class="btn">{t.common.bookCta}</a>
      <a href={localePath(lang, 'training')} class="more">{t.master.toTraining} <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
