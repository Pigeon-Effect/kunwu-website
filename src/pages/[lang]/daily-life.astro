---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Photo from '../../components/Photo.astro';
import DayRing from '../../components/DayRing.astro';
import { galleryCaptions } from '../../data/gallery';
import { gallerySketches, sketches } from '../../data/sketches';
import { videos, channels } from '../../data/videos';
import { asset, getLangStaticPaths, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);

// Gallery: every image dropped into src/assets/photos/gallery/ shows up here, sorted by file name.
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/gallery/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const gallery = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path.split('/').pop() ?? path;
    return { src: mod.default, alt: galleryCaptions[name]?.[lang] ?? `[PLACEHOLDER: alt text for ${name}]` };
  });
// Until real photos are added, the gallery shows the pencil sketches.
const galleryItems = gallery.length ? gallery : gallerySketches.map((g) => ({ src: g.src, alt: g.alt[lang] }));

const clips = await Promise.all(
  videos.map(async (v) => ({
    ...v,
    posterUrl: (await getImage({ src: v.poster, width: 960, format: 'webp' })).src,
  })),
);

const life = [
  { title: t.daily.livingTitle, text: t.daily.livingText, image: sketches['student-room'] },
  { title: t.daily.foodTitle, text: t.daily.foodText, image: sketches['dining'] },
  { title: t.daily.restTitle, text: t.daily.restText, image: sketches['rest-day'] },
];
---

<Base lang={lang} title={t.meta.dailyLife.title} description={t.meta.dailyLife.description} route="dailyLife">
  <PageHead title={t.daily.title} lede={t.daily.lede} />

  <section class="bg-rice py-16 sm:py-20" aria-labelledby="schedule-title">
    <div class="wrap">
      <h2 id="schedule-title" class="mb-10 text-4xl sm:text-5xl">{t.daily.scheduleTitle}</h2>
      <DayRing lang={lang} id="daily-ring" />
    </div>
  </section>

  <div class="wrap space-y-16 py-16 sm:space-y-24 sm:py-24">
    {
      life.map((item, i) => (
        <section class="grid items-center gap-8 md:grid-cols-2 md:gap-16">
          <div class:list={[i % 2 === 1 && 'md:order-2']}>
            <Photo src={item.image.src} alt={item.image.alt[lang]} sizes="(min-width: 48rem) 34rem, 100vw" />
          </div>
          <div>
            <h2 class="text-3xl sm:text-4xl">{item.title}</h2>
            <p class="mt-4 max-w-md text-lg text-ink-soft">{item.text}</p>
          </div>
        </section>
      ))
    }
  </div>

  <section class="wrap pb-16 sm:pb-24" aria-labelledby="gallery-title">
    <h2 id="gallery-title" class="text-4xl sm:text-5xl">{gallery.length ? t.daily.galleryTitle : t.daily.sketchbookTitle}</h2>
    <p class="mt-3 text-ink-soft">{gallery.length ? t.daily.galleryLede : t.daily.sketchbookLede}</p>
    <div class="mt-10 columns-2 gap-3 sm:gap-4 lg:columns-3 [&>*]:mb-3 sm:[&>*]:mb-4">
      {
        galleryItems.map((g) => (
          <Photo src={g.src} alt={g.alt} ratio={`${g.src.width}/${g.src.height}`} sizes="(min-width: 64rem) 22rem, 50vw" widths={[360, 540, 720, 1080]} />
        ))
      }
    </div>
  </section>

  <section class="wrap pb-20 sm:pb-28" aria-labelledby="videos-title">
    <h2 id="videos-title" class="text-4xl sm:text-5xl">{t.daily.videosTitle}</h2>
    <p class="mt-3 text-ink-soft">{t.daily.videosLede}</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        clips.map((c) => (
          <figure>
            <video
              controls
              playsinline
              preload="none"
              poster={c.posterUrl}
              width={c.width}
              height={c.height}
              class="h-auto w-full bg-ink"
            >
              <source src={asset(c.file)} type="video/mp4" />
            </video>
            <figcaption class="mt-2 text-sm text-ink-soft">{c.title[lang]}</figcaption>
          </figure>
        ))
      }
      {
        clips.length === 0 &&
          [1, 2, 3].map((n) => <Photo alt={`${t.daily.videoPh} ${n}`} ratio="9/16" />)
      }
    </div>
    <p class="mt-8">
      {
        channels.length
          ? channels.map((c) => (
              <a href={c.url} rel="noopener" class="mr-6">
                {c.label} ↗
              </a>
            ))
          : t.daily.channelPh
      }
    </p>
  </section>
</Base>
