---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Photo from '../../components/Photo.astro';
import DayRing from '../../components/DayRing.astro';
import Seal from '../../components/Seal.astro';
import { galleryCaptions } from '../../data/gallery';
import { videos, channels } from '../../data/videos';
import { asset, getLangStaticPaths, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);

// Gallery: every image dropped into src/assets/photos/gallery/ shows up here, sorted by file name.
// The section only appears once there is at least one photo.
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/gallery/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const gallery = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path.split('/').pop() ?? path;
    return { src: mod.default, alt: galleryCaptions[name]?.[lang] ?? `[PLACEHOLDER: alt text for ${name}]` };
  });

const clips = await Promise.all(
  videos.map(async (v) => ({
    ...v,
    posterUrl: (await getImage({ src: v.poster, width: 960, format: 'webp' })).src,
  })),
);

// 住 · 食 · 休 – living, eating, resting
const life = [
  { seal: '住', title: t.daily.livingTitle, text: t.daily.livingText },
  { seal: '食', title: t.daily.foodTitle, text: t.daily.foodText },
  { seal: '休', title: t.daily.restTitle, text: t.daily.restText },
];
---

<Base lang={lang} title={t.meta.dailyLife.title} description={t.meta.dailyLife.description} route="dailyLife">
  <PageHead title={t.daily.title} lede={t.daily.lede} inscription={['晨钟暮鼓']} seal="日常" />

  <section class="bg-rice py-16 sm:py-20" aria-labelledby="schedule-title">
    <div class="wrap">
      <h2 id="schedule-title" class="mb-10 text-4xl sm:text-5xl">{t.daily.scheduleTitle}</h2>
      <DayRing lang={lang} id="daily-ring" />
    </div>
  </section>

  <div class="wrap grid gap-12 py-16 sm:py-24 md:grid-cols-3 md:gap-10">
    {
      life.map((item) => (
        <section class="border-t border-gold pt-8">
          <Seal text={item.seal} size="lg" />
          <h2 class="mt-6 text-3xl">{item.title}</h2>
          <p class="mt-4 text-lg text-ink-soft">{item.text}</p>
        </section>
      ))
    }
  </div>

  {
    gallery.length > 0 && (
      <section class="wrap pb-16 sm:pb-24" aria-labelledby="gallery-title">
        <h2 id="gallery-title" class="text-4xl sm:text-5xl">
          {t.daily.galleryTitle}
        </h2>
        <p class="mt-3 text-ink-soft">{t.daily.galleryLede}</p>
        <div class="mt-10 columns-2 gap-4 lg:columns-3 [&>*]:mb-4">
          {gallery.map((g) => (
            <Photo src={g.src} alt={g.alt} sizes="(min-width: 64rem) 22rem, 50vw" widths={[360, 540, 720, 1080]} />
          ))}
        </div>
      </section>
    )
  }

  {
    (clips.length > 0 || channels.length > 0) && (
      <section class="wrap pb-20 sm:pb-28" aria-labelledby="videos-title">
        <h2 id="videos-title" class="text-4xl sm:text-5xl">
          {t.daily.videosTitle}
        </h2>
        <p class="mt-3 text-ink-soft">{t.daily.videosLede}</p>
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {clips.map((c) => (
            <figure>
              <video controls playsinline preload="none" poster={c.posterUrl} width={c.width} height={c.height} class="h-auto w-full bg-ink">
                <source src={asset(c.file)} type="video/mp4" />
              </video>
              <figcaption class="mt-2 text-sm text-ink-soft">{c.title[lang]}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-8">
          {channels.map((c) => (
            <a href={c.url} rel="noopener" class="mr-6">
              {c.label} ↗
            </a>
          ))}
        </p>
      </section>
    )
  }
</Base>
