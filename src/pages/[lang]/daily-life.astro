---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import DayRing from '../../components/DayRing.astro';
import Seal from '../../components/Seal.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { sections } from '../../config/sections';
import Gallery from '../../components/Gallery.astro';
import { gallery } from '../../data/gallery';
import { videos, channels } from '../../data/videos';
import { asset, getLangStaticPaths, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);

const clips = await Promise.all(
  videos.map(async (v) => ({
    ...v,
    posterUrl: (await getImage({ src: v.poster, width: 960, format: 'webp' })).src,
  })),
);

// 住 · 食 · 休 – living, eating, resting
const life = [
  { seal: '住', title: t.daily.livingTitle, text: t.daily.livingText },
  { seal: '食', title: t.daily.foodTitle, text: t.daily.foodText },
  { seal: '休', title: t.daily.restTitle, text: t.daily.restText },
];
---

<Base lang={lang} title={t.meta.dailyLife.title} description={t.meta.dailyLife.description} route="dailyLife">
  <PageHead lang={lang} section="dailyLife" title={t.daily.title} lede={t.daily.lede} />

  <section class="border-t border-paper/10 bg-ink-raised py-20 sm:py-28" aria-labelledby="schedule-title">
    <div class="wrap">
      <SectionLabel as="p" decorative lang={lang} {...sections.schedule} label={t.daily.scheduleTitle} />
      <h2 id="schedule-title" class="mt-5 mb-12 text-4xl sm:text-6xl">{t.daily.scheduleTitle}</h2>
      <DayRing lang={lang} id="daily-ring" />
    </div>
  </section>

  <div class="wrap grid gap-14 py-20 sm:py-28 md:grid-cols-3 md:gap-12">
    {
      life.map((item, i) => (
        <section class="reveal border-t border-paper/15 pt-8" style={`--reveal-delay:${i * 120}ms`}>
          <Seal text={item.seal} size="md" />
          <h2 class="mt-7 text-3xl sm:text-4xl">{item.title}</h2>
          <p class="mt-4 text-stone">{item.text}</p>
        </section>
      ))
    }
  </div>

  {
    gallery.length > 0 && (
      <section class="border-t border-paper/10 py-20 sm:py-28" aria-labelledby="gallery-title">
        <div class="wrap">
          <SectionLabel as="p" decorative lang={lang} {...sections.gallery} label={t.daily.galleryTitle} />
          <h2 id="gallery-title" class="mt-5 text-4xl sm:text-6xl">
            {t.daily.galleryTitle}
          </h2>
          <p class="mt-4 text-stone">{t.daily.galleryLede}</p>
          <div class="mt-12">
            <Gallery ids={gallery} lang={lang} />
          </div>
        </div>
      </section>
    )
  }

  {
    (clips.length > 0 || channels.length > 0) && (
      <section class="wrap border-t border-paper/10 py-20 sm:py-28" aria-labelledby="videos-title">
        <h2 id="videos-title" class="text-4xl sm:text-5xl">
          {t.daily.videosTitle}
        </h2>
        <p class="mt-3 text-stone">{t.daily.videosLede}</p>
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {clips.map((c) => (
            <figure>
              <video controls playsinline preload="none" poster={c.posterUrl} width={c.width} height={c.height} class="h-auto w-full bg-ink">
                <source src={asset(c.file)} type="video/mp4" />
              </video>
              <figcaption class="mt-2 text-sm text-stone">{c.title[lang]}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-8">
          {channels.map((c) => (
            <a href={c.url} rel="noopener" class="mr-6">
              {c.label} ↗
            </a>
          ))}
        </p>
      </section>
    )
  }
</Base>
