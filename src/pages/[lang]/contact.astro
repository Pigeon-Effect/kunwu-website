---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Photo from '../../components/Photo.astro';
import { address, contact, mapLink } from '../../config/site';
import { getLangStaticPaths, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
---

<Base lang={lang} title={t.meta.contact.title} description={t.meta.contact.description} route="contact">
  <PageHead title={t.contact.title} lede={t.contact.lede} inscription={['有朋自远方来']} seal="坤武" />

  <div class="wrap grid gap-12 pb-20 sm:pb-28 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
    <div class="space-y-12">
      <section aria-labelledby="address-title">
        <h2 id="address-title" class="text-3xl">{t.contact.addressTitle}</h2>
        <address class="mt-4 text-lg not-italic">
          {(lang === 'zh' ? address.zhLines : address.enLines).map((l) => <span class="block">{l}</span>)}
        </address>
        {!address.confirmed && <p class="mt-3 text-sm">{t.contact.toConfirm}</p>}
        <p class="mt-5">
          <a href={mapLink()} rel="noopener">{t.contact.mapLink} ↗</a>
          {!contact.coordinates && <span class="ml-2 text-sm">{t.contact.mapPh}</span>}
        </p>
      </section>

      <!-- The Chinese address, large: show it to a taxi driver -->
      <section class="relative overflow-hidden bg-rice p-7 sm:p-10" aria-labelledby="driver-title">
        <div class="fret absolute inset-x-0 top-0" aria-hidden="true"></div>
        <h2 id="driver-title" class="text-2xl">{t.contact.driverTitle}</h2>
        <p class="mt-2 text-ink-soft">{t.contact.driverText}</p>
        <p class="cjk mt-6 text-2xl leading-relaxed tracking-[0.06em] text-ink sm:text-[2rem]" lang="zh-Hans">
          {address.zhLines.slice().reverse().map((l) => <span class="block">{l}</span>)}
        </p>
      </section>

      <p class="text-ink-soft">
        {t.contact.timeNote}
      </p>
    </div>

    <div class="space-y-10">
      <section aria-labelledby="wechat-title">
        <h2 id="wechat-title" class="text-3xl">{t.contact.wechatTitle}</h2>
        <div class="mt-5 max-w-[15rem]">
          {
            contact.wechatQr ? (
              <Image src={contact.wechatQr} alt={t.contact.wechatQrAlt} width={480} class="h-auto w-full" />
            ) : (
              <Photo alt={t.contact.wechatQrPh} ratio="1/1" />
            )
          }
        </div>
        <p class="mt-4">
          {t.contact.wechatId}: <span class="font-medium">{contact.wechatId ?? t.contact.wechatIdPh}</span>
        </p>
      </section>

      <section aria-labelledby="email-title" class="border-t border-gold-pale pt-8">
        <h2 id="email-title" class="text-3xl">{t.contact.emailTitle}</h2>
        <p class="mt-3 text-lg">
          {contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : t.contact.emailPh}
        </p>
      </section>

      <section aria-labelledby="phone-title" class="border-t border-gold-pale pt-8">
        <h2 id="phone-title" class="text-3xl">{t.contact.phoneTitle}</h2>
        <p class="mt-3 text-lg">
          {contact.phone ? <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a> : t.contact.phonePh}
        </p>
      </section>
    </div>
  </div>
</Base>
