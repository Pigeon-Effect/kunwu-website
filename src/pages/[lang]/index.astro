---
/**
 * Home – 山水, landscape. One painted landscape fills the first screen (after Ren Yu, with small figures
 * practising on the ground by the pavilion), then the school's 武德 under Fan Qi's temple on the cliff,
 * then the way to the booking. Masters, programs, daily life and contact each have their own page.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Seal from '../../components/Seal.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Painting from '../../components/Painting.astro';
import BrushRule from '../../components/BrushRule.astro';
import Calligraphy from '../../components/Calligraphy.astro';
import { sections } from '../../config/sections';
import { paintings } from '../../data/paintings';
import { getLangStaticPaths, localePath, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const zh = lang === 'zh';
const saying = ['未曾学艺先学礼', '未曾习武先习德'] as const;
const sayingEn = useT('en').home.sayingText;

// the hero painting, art-directed: its right part for portrait screens, the whole picture otherwise
const TALL = '(max-aspect-ratio: 4/5)';
const art = async (image: ImageMetadata, widths: number[]) => {
  // ink painting: a low AVIF quality looks the same on screen at a third of the size
  const opts = { src: image, widths, quality: 40 };
  const [avif, webp] = await Promise.all([getImage({ ...opts, format: 'avif' }), getImage({ ...opts, format: 'webp' })]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, fallback: webp.src };
};
const tall = await art(paintings.heroTall.image, [480, 640, 800, 1000, 1200, 1600]);
const wide = await art(paintings.heroWide.image, [960, 1280, 1600, 2000, 2400, 3168]);
// The picture is never cropped: it stands at the bottom right, as wide as the screen or as tall as the
// first screen, whichever is smaller (see .hero-art); on portrait screens it follows the title.
const tallSizes = 'min(100vw, 40rem)';
const wideSizes = '(min-aspect-ratio: 21/9) calc((100vh - 4.5rem) * 2.36), 100vw';
---

<Base lang={lang} title={t.meta.home.title} description={t.meta.home.description} route="home" paintings={['heroWide', 'cliffTemple']}>
  <!-- 1 · 山水: the landscape – the title written down the left like an inscription, sealed -->
  <section class="hero relative isolate" aria-labelledby="hero-title">
    <!-- the name, written down the mist on the left like an inscription, sealed; beside it the way in -->
    <div class="hero-inner wrap">
      <div class="flex items-start gap-5 sm:gap-8">
        <Calligraphy text="坤武功夫" size="clamp(3rem, 9vw, 6.8rem)" gap="-0.02em" delay={700} speed={1.7} eager class="hero-write shrink-0" />
        <div class="min-w-0 pt-2">
          <h1 id="hero-title" class="font-display text-[clamp(1.5rem,3vw,2.1rem)] leading-[1.1] tracking-[0.06em]">
            <span class="sr-only" lang="zh-Hans">坤武功夫</span>
            <span class="block" lang="en">Kunwu<br />Kung Fu</span>
          </h1>
          <Seal text="坤武功夫" size="lg" class="mt-6 ml-0.5" />
          <div class="hero-call">
            <p class="text-lg text-ink-soft">{t.home.tagline}</p>
            <a href={localePath(lang, 'book')} class="btn mt-5">{t.common.bookCta}</a>
          </div>
        </div>
      </div>
    </div>

    <!-- the landscape, whole, at the bottom right – and where its own inscription stood, Wang Wei's couplet
         in the site's brush, right column first -->
    <div class="hero-art">
      <picture>
        <source media={TALL} type="image/avif" srcset={tall.avif} sizes={tallSizes} />
        <source media={TALL} type="image/webp" srcset={tall.webp} sizes={tallSizes} />
        <source type="image/avif" srcset={wide.avif} sizes={wideSizes} />
        <img
          src={wide.fallback}
          srcset={wide.webp}
          sizes={wideSizes}
          width={paintings.heroWide.image.width}
          height={paintings.heroWide.image.height}
          alt={t.home.heroAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="ink ink-in block h-full w-full"
        />
      </picture>
      <div class="couplet" aria-hidden="true">
        <Calligraphy text="行到水穷处" animate={false} size="var(--cp-size)" gap="calc(var(--cp-size) * 0.12)" />
        <Calligraphy text="坐看云起时" animate={false} size="var(--cp-size)" gap="calc(var(--cp-size) * 0.12)" />
      </div>
    </div>
  </section>

  <!-- 2 · 武德: the old saying, the lineage – beside a temple on a cliff top, its foot in cloud -->
  <section id="philosophy" class="pt-24 pb-20 sm:pt-32 sm:pb-28" aria-labelledby="philosophy-label">
    <div class="wrap grid grid-cols-[minmax(0,1fr)] items-start gap-14 md:grid-cols-[minmax(0,1fr)_auto] md:gap-16">
      <div>
        <SectionLabel id="philosophy-label" lang={lang} {...sections.philosophy} label={t.nav.philosophy} />
        <figure class="reveal mt-10">
          <blockquote>
            {
              zh ? (
                <p class="font-display text-[clamp(1.9rem,4.2vw,3.2rem)] leading-[1.35]">{t.home.sayingText}</p>
              ) : (
                <p class="font-display text-[clamp(2.1rem,4.4vw,3.5rem)] leading-[1.1] italic">“{t.home.sayingText}”</p>
              )
            }
          </blockquote>
          <figcaption class="mt-6 text-sm tracking-[0.14em] text-ink-soft">— {t.home.sayingSource}</figcaption>
          {zh && <p class="mt-4 font-display text-xl text-ink-soft italic" lang="en">{sayingEn}</p>}
        </figure>
        <p class="reveal mt-14 max-w-xl text-lg text-ink-soft" style="--reveal-delay:120ms">{t.home.lineageText}</p>
      </div>

      <!-- Fan Qi's cliff, whole, and in the open paper beside it the saying as a vertical inscription, sealed –
           next to the painting, never on its rocks -->
      <div class="reveal flex items-start justify-end gap-5 sm:gap-7" style="--reveal-delay:200ms">
        <div class="inscription shrink-0" lang="zh-Hans" aria-hidden={zh ? 'true' : undefined}>
          <p class="sr-only">{saying.join('，')}。</p>
          <div class="flex flex-row-reverse items-start gap-6" aria-hidden="true">
            <Calligraphy text={saying[0]} animate={false} size="clamp(2.2rem, 5.5vw, 2.7rem)" gap="0.3rem" />
            <span class="flex flex-col items-center">
              <Calligraphy text={saying[1]} animate={false} size="clamp(2.2rem, 5.5vw, 2.7rem)" gap="0.3rem" class="mt-12" />
              <Seal text="德" style="zhu" size="sm" class="mt-6" />
            </span>
          </div>
        </div>
        <Painting
          name="cliffTemple"
          sizes="(min-width: 48rem) clamp(15rem, 24vw, 21rem), 56vw"
          widths={[300, 450, 600, 900]}
          class="cliff h-auto"
        />
      </div>
    </div>
  </section>

  <BrushRule />

  <!-- 3 · 报名: the way in -->
  <section class="pt-20 pb-24 sm:pt-28 sm:pb-32" aria-labelledby="book-label">
    <div class="wrap">
      <SectionLabel id="book-label" lang={lang} {...sections.book} label={t.nav.book} />
      <a href={localePath(lang, 'book')} class="cta-big group mt-8 inline-flex flex-wrap items-baseline gap-x-6 no-underline">
        <span class="font-display">{t.common.bookCta}</span>
        <span class="cta-arrow text-vermilion" aria-hidden="true">→</span>
      </a>
      <p class="mt-6 max-w-xl text-lg text-ink-soft">
        {t.home.contactLede}
        <a href={localePath(lang, 'contact')} class="ml-1 whitespace-nowrap text-ink">{t.nav.contact} →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* 1 · the first screen: the name in the mist on the left, the landscape at the bottom right */
  .hero {
    --hero-h: calc(100svh - 4.5rem);
    display: flex;
    flex-direction: column;
    min-height: var(--hero-h);
  }
  .hero-inner {
    padding-top: max(2.5rem, 6svh);
    padding-bottom: 1.5rem;
  }
  .hero-call {
    margin-top: 1.75rem;
    max-width: 22rem;
  }
  :global(.hero-write) {
    margin-left: -0.15rem;
  }

  /* The landscape is never cropped.
     Portrait screens – its right part (2916 × 2688): it follows the title, as wide as the screen.
     Landscape screens – the whole picture (6336 × 2688): it stands at the bottom right, as wide as the screen
     or as tall as the first screen, whichever is smaller; its left half is open mist, where the name stands. */
  .hero-art {
    position: relative;
    z-index: -1;
    container-type: inline-size;
    align-self: flex-end;
    width: min(100%, 40rem);
    aspect-ratio: 2916 / 2688;
    margin-top: auto;
    /* the couplet, where the picture's own inscription stood (cqw: % of the picture's width) */
    --cp-size: 3.4cqw;
    --cp-top: 2.2cqw;
    --cp-right: 2.4cqw;
  }
  @media (min-aspect-ratio: 4/5) {
    .hero-art {
      position: absolute;
      right: 0;
      bottom: 0;
      width: min(100%, calc(var(--hero-h) * 6336 / 2688));
      aspect-ratio: 6336 / 2688;
      --cp-size: 1.22cqw;
      --cp-top: 1cqw;
      --cp-right: 0.9cqw;
    }
  }
  .couplet {
    position: absolute;
    top: var(--cp-top);
    right: var(--cp-right);
    display: flex;
    flex-direction: row-reverse;
    gap: calc(var(--cp-size) * 0.55);
  }

  /* Fan Qi's cliff, inside the page; the inscription stands beside its lower half */
  :global(.cliff) {
    width: 56vw;
    flex-shrink: 0;
  }
  @media (min-width: 48rem) {
    :global(.cliff) {
      width: clamp(15rem, 24vw, 21rem);
    }
  }
  .inscription {
    padding-top: 4rem;
  }

  .cta-big {
    font-size: clamp(2.8rem, 8.5vw, 7rem);
    line-height: 1;
  }
  .cta-arrow {
    transition: transform 400ms var(--ease-out-soft);
  }
  .cta-big:hover .cta-arrow {
    transform: translateX(0.15em);
  }
</style>
