---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import DayRing from '../../components/DayRing.astro';
import Seal from '../../components/Seal.astro';
import Inscription from '../../components/Inscription.astro';
import { fromPrice, formatPrice } from '../../config/booking';
import { masterEarlyYears, masterSideKickPortrait } from '../../data/photos';
import { getLangStaticPaths, intlLocale, localePath, splitId, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const programs = (await getCollection('programs', (e) => splitId(e.id).lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base lang={lang} title={t.meta.home.title} description={t.meta.home.description} route="home">
  <!-- Hero: type, one photo in a moon-gate arch, an inscription beside it -->
  <section class="wrap grid items-center gap-12 pt-10 pb-16 sm:pt-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14 lg:pt-20 lg:pb-24">
    <div>
      <h1 class="text-[2.75rem] leading-[1.08] sm:text-7xl lg:text-[4.9rem]">
        {t.home.heroTitle.map((line) => <span class="block">{line}</span>)}
      </h1>
      <p class="mt-7 max-w-xl text-lg text-ink-soft sm:text-xl">{t.home.heroLede}</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href={localePath(lang, 'book')} class="btn">{t.common.bookCta}</a>
        <a href="#day" class="py-2">{t.home.heroSecondary}</a>
      </div>
    </div>
    <div class="flex items-start justify-center gap-6 lg:justify-end">
      <Photo
        src={masterSideKickPortrait.src}
        alt={masterSideKickPortrait.alt[lang]}
        frame="moon"
        eager
        sizes="(min-width: 64rem) 26rem, 90vw"
        widths={[480, 720, 960, 1280, 1760]}
        class="w-full max-w-[26rem] p-2"
      />
      <div class="hidden pt-10 sm:block">
        <Inscription lines={['少林功夫', '日日修行']} seal="坤武" />
      </div>
    </div>
  </section>

  <!-- The day ring with the twelve double hours -->
  <section id="day" class="bg-rice py-16 sm:py-24" aria-labelledby="day-title">
    <div class="wrap">
      <div class="mb-10 max-w-2xl">
        <h2 id="day-title" class="text-4xl sm:text-5xl">{t.home.dayTitle}</h2>
        <p class="mt-4 text-lg text-ink-soft">{t.home.dayLede}</p>
      </div>
      <DayRing lang={lang} id="home-ring" />
      <p class="mt-10">
        <a href={localePath(lang, 'dailyLife')}>{t.home.dayLink} →</a>
      </p>
    </div>
  </section>

  <!-- The master -->
  <section class="wrap grid items-center gap-12 py-16 sm:py-24 md:grid-cols-[0.8fr_1.2fr] md:gap-16" aria-labelledby="master-title">
    <Photo
      src={masterEarlyYears.src}
      alt={masterEarlyYears.alt[lang]}
      frame="print"
      caption={masterEarlyYears.caption?.[lang]}
      captionZh={lang === 'en' ? masterEarlyYears.caption?.zh : undefined}
      sizes="(min-width: 48rem) 22rem, 90vw"
      class="mx-auto w-full max-w-[22rem] md:mx-0"
    />
    <div>
      <p class="text-gold-deep">{t.home.masterKicker}</p>
      <h2 id="master-title" class="mt-3">
        <span class="cjk block text-6xl tracking-[0.12em] text-ink sm:text-7xl" lang="zh-Hans">释延朋</span>
        {lang === 'en' && <span class="mt-4 block text-3xl">Master Shi Yanpeng</span>}
      </h2>
      <p class="mt-6 max-w-xl text-lg text-ink-soft">{t.home.masterLede}</p>
      <p class="mt-8">
        <a href={localePath(lang, 'master')}>{t.home.masterLink} →</a>
      </p>
    </div>
  </section>

  <!-- Programs: each marked with its own seal -->
  <section class="wrap pb-16 sm:pb-24" aria-labelledby="programs-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="programs-title" class="text-4xl sm:text-5xl">{t.home.programsTitle}</h2>
        <p class="mt-3 text-ink-soft">{t.home.programsLede}</p>
      </div>
      <a href={localePath(lang, 'training')}>{t.home.programsLink} →</a>
    </div>
    <ul class="mt-10 border-t border-gold">
      {
        programs.map((p) => {
          const price = fromPrice(p.data.program);
          return (
            <li class="border-b border-gold">
              <a
                href={localePath(lang, 'training', p.data.program)}
                class="group grid grid-cols-[auto_1fr] items-center gap-x-5 gap-y-1 py-6 no-underline sm:grid-cols-[auto_14rem_1fr_auto] sm:gap-x-8"
              >
                <Seal text={p.data.seal} size="md" class="row-span-2 sm:row-span-1" />
                <span class="font-display text-2xl group-hover:text-vermilion sm:text-3xl">{p.data.title}</span>
                <span class="text-ink-soft">{p.data.summary}</span>
                <span class="col-start-2 text-sm whitespace-nowrap text-ink-soft sm:col-start-auto">
                  {price !== null ? `${t.common.from} ${formatPrice(price, intlLocale[lang])}` : t.training.pricePh}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="mt-10">
      <a href={localePath(lang, 'book')} class="btn">{t.common.bookCta}</a>
    </div>
  </section>

  <!-- A saying of the martial arts, in vertical script -->
  <section class="bg-rice" aria-labelledby="saying-title">
    <div class="fret" aria-hidden="true"></div>
    <div class="wrap grid items-center gap-12 py-16 sm:py-24 md:grid-cols-[1fr_auto] md:gap-20">
      <div class="max-w-xl">
        <h2 id="saying-title" class="text-gold-deep text-base! font-sans! tracking-normal!">{t.home.sayingKicker}</h2>
        {lang === 'en' && <p class="font-display mt-5 text-3xl leading-snug sm:text-4xl">{t.home.sayingText}</p>}
        <p class:list={['text-lg text-ink-soft', lang === 'en' ? 'mt-6' : 'mt-5']}>{t.home.sayingNote}</p>
      </div>
      <div class="justify-self-center md:justify-self-end" lang="zh-Hans">
        <p class="sr-only">未曾学艺先学礼，未曾习武先习德。</p>
        <div class="saying flex flex-row-reverse items-start gap-6" aria-hidden="true">
          <span class="kai text-[2.4rem] leading-none tracking-[0.28em] text-ink [writing-mode:vertical-rl] sm:text-[2.9rem]">未曾学艺先学礼</span>
          <div class="flex flex-col items-center">
            <span class="kai mt-[1.2em] text-[2.4rem] leading-none tracking-[0.28em] text-ink [writing-mode:vertical-rl] sm:text-[2.9rem]">未曾习武先习德</span>
            <Seal text="武德" size="md" class="mt-5" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
