---
/**
 * Home – 山水, landscape. One painted landscape fills the first screen (after Ren Yu, with small figures
 * practising on the ground by the pavilion), then the school's 武德 under Fan Qi's temple on the cliff,
 * then the way to the booking. Masters, programs, daily life and contact each have their own page.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Seal from '../../components/Seal.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Painting from '../../components/Painting.astro';
import BrushRule from '../../components/BrushRule.astro';
import Calligraphy from '../../components/Calligraphy.astro';
import { sections } from '../../config/sections';
import { paintings } from '../../data/paintings';
import { getLangStaticPaths, localePath, useT, type Lang } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const zh = lang === 'zh';
const saying = ['未曾学艺先学礼', '未曾习武先习德'] as const;
const sayingEn = useT('en').home.sayingText;

// the hero painting, art-directed: a tall composition for portrait screens, a wide one otherwise
const TALL = '(max-aspect-ratio: 4/5)';
const art = async (image: ImageMetadata, widths: number[]) => {
  // soft ink painting: a low AVIF quality looks the same on screen at a third of the size
  const opts = { src: image, widths, quality: 38 };
  const [avif, webp] = await Promise.all([getImage({ ...opts, format: 'avif' }), getImage({ ...opts, format: 'webp' })]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, fallback: webp.src };
};
const tall = await art(paintings.heroTall.image, [480, 640, 800, 1000, 1200]);
const wide = await art(paintings.heroWide.image, [960, 1280, 1600, 2000, 2400]);
// The image covers the screen. A soft ink painting needs no more than ~1.5 image px per CSS px, so the
// sizes ask for a little less than the full device resolution on dense phone screens.
const tallSizes = '(min-aspect-ratio: 6/11) 76vw, calc((100vh - 4.5rem) * 0.42)';
const wideSizes = '(max-aspect-ratio: 12/7) calc((100vh - 4.5rem) * 1.72), 100vw';
---

<Base lang={lang} title={t.meta.home.title} description={t.meta.home.description} route="home" paintings={['heroWide', 'cliffTemple']}>
  <!-- 1 · 山水: the landscape – the title written down the left like an inscription, sealed -->
  <section class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
    <picture>
      <source media={TALL} type="image/avif" srcset={tall.avif} sizes={tallSizes} />
      <source media={TALL} type="image/webp" srcset={tall.webp} sizes={tallSizes} />
      <source type="image/avif" srcset={wide.avif} sizes={wideSizes} />
      <img
        src={wide.fallback}
        srcset={wide.webp}
        sizes={wideSizes}
        width={paintings.heroWide.image.width}
        height={paintings.heroWide.image.height}
        alt={t.home.heroAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="ink ink-in hero-art absolute inset-0 -z-10 h-full w-full object-cover"
      />
    </picture>

    <div class="hero-inner wrap flex flex-col">
      <h1 id="hero-title" class="flex items-start gap-5 sm:gap-8">
        <span class="sr-only" lang="zh-Hans">坤武功夫</span>
        <Calligraphy text="坤武功夫" size="clamp(3.6rem, 9vw, 6.8rem)" gap="-0.02em" delay={700} speed={1.7} eager class="hero-write" />
        <span class="mt-2 block font-display text-[clamp(1.4rem,3vw,2.1rem)] leading-[1.1] tracking-[0.06em]" lang="en">
          Kunwu<br />Kung Fu
        </span>
      </h1>
      <Seal text="坤武功夫" size="lg" class="mt-6 ml-1" />

      <div class="hero-call max-w-sm">
        <p class="text-lg text-ink-soft">{t.home.tagline}</p>
        <a href={localePath(lang, 'book')} class="btn mt-6">{t.common.bookCta}</a>
      </div>
    </div>
  </section>

  <!-- 2 · 武德: the old saying, the lineage – under a temple on a cliff top, its foot in cloud -->
  <section id="philosophy" class="relative isolate overflow-hidden pt-24 pb-20 sm:pt-32 sm:pb-28" aria-labelledby="philosophy-label">
    <Painting
      name="cliffTemple"
      sizes="(min-width: 64rem) 30rem, (min-width: 48rem) 40vw, 78vw"
      widths={[360, 540, 720, 900]}
      class="cliff -z-10 h-auto"
    />
    <div class="wrap relative grid grid-cols-[minmax(0,1fr)] items-start gap-16 md:grid-cols-[minmax(0,1fr)_auto] md:gap-20">
      <div>
        <SectionLabel id="philosophy-label" lang={lang} {...sections.philosophy} label={t.nav.philosophy} />
        <figure class="reveal mt-10">
          <blockquote>
            {
              zh ? (
                <p class="font-display text-[clamp(1.9rem,4.6vw,3.4rem)] leading-[1.35]">{t.home.sayingText}</p>
              ) : (
                <p class="font-display text-[clamp(2.1rem,5vw,4rem)] leading-[1.08] italic">“{t.home.sayingText}”</p>
              )
            }
          </blockquote>
          <figcaption class="mt-6 text-sm tracking-[0.14em] text-ink-soft">— {t.home.sayingSource}</figcaption>
          {zh && <p class="mt-4 font-display text-xl text-ink-soft italic" lang="en">{sayingEn}</p>}
        </figure>
        <p class="reveal mt-14 max-w-xl text-lg text-ink-soft" style="--reveal-delay:120ms">{t.home.lineageText}</p>
      </div>

      <!-- the saying as a vertical inscription beside the cliff, signed with a seal -->
      <div class="inscription reveal justify-self-center md:justify-self-end" style="--reveal-delay:200ms" lang="zh-Hans" aria-hidden={zh ? 'true' : undefined}>
        <p class="sr-only">{saying.join('，')}。</p>
        <div class="flex flex-row-reverse items-start gap-7" aria-hidden="true">
          <Calligraphy text={saying[0]} animate={false} size="clamp(2.5rem, 6vw, 2.9rem)" gap="0.35rem" />
          <span class="flex flex-col items-center">
            <Calligraphy text={saying[1]} animate={false} size="clamp(2.5rem, 6vw, 2.9rem)" gap="0.35rem" class="mt-12" />
            <Seal text="德" style="zhu" size="sm" class="mt-6" />
          </span>
        </div>
      </div>
    </div>
  </section>

  <BrushRule />

  <!-- 3 · 报名: the way in -->
  <section class="pt-20 pb-24 sm:pt-28 sm:pb-32" aria-labelledby="book-label">
    <div class="wrap">
      <SectionLabel id="book-label" lang={lang} {...sections.book} label={t.nav.book} />
      <a href={localePath(lang, 'book')} class="cta-big group mt-8 inline-flex flex-wrap items-baseline gap-x-6 no-underline">
        <span class="font-display">{t.common.bookCta}</span>
        <span class="cta-arrow text-vermilion" aria-hidden="true">→</span>
      </a>
      <p class="mt-6 max-w-xl text-lg text-ink-soft">
        {t.home.contactLede}
        <a href={localePath(lang, 'contact')} class="ml-1 whitespace-nowrap text-ink">{t.nav.contact} →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* the landscape fills the first screen below the header */
  .hero {
    min-height: calc(100svh - 4.5rem);
  }
  .hero-inner {
    min-height: calc(100svh - 4.5rem);
    padding-top: max(3rem, 7svh);
    padding-bottom: 2.5rem;
  }
  /* the painting keeps its peaks, grove and figures (the right side) when the screen is narrower */
  .hero-art {
    object-position: 100% 100%;
  }
  /* portrait screens: the call follows the seal, above the grove and the figures on the bank;
     landscape screens: it sits at the foot of the open water */
  .hero-call {
    margin-top: 2.25rem;
  }
  @media (min-aspect-ratio: 4/5) {
    .hero-call {
      margin-top: auto;
      padding-top: 2.5rem;
    }
  }

  :global(.hero-write) {
    margin-left: -0.15rem;
  }

  /* Fan Qi's cliff: top right, the inscription stands at its misty foot */
  :global(.cliff) {
    position: absolute;
    top: 1rem;
    right: -1.5rem;
    width: min(78vw, 30rem);
    opacity: 0.95;
  }
  @media (max-width: 47.99rem) {
    /* phones: the cliff stands behind the inscription, below the saying */
    :global(.cliff) {
      top: auto;
      bottom: 3rem;
      right: -3rem;
      width: 82vw;
      opacity: 0.85;
    }
  }
  @media (min-width: 48rem) {
    .inscription {
      padding-top: 17rem;
    }
  }

  .cta-big {
    font-size: clamp(2.8rem, 8.5vw, 7rem);
    line-height: 1;
  }
  .cta-arrow {
    transition: transform 400ms var(--ease-out-soft);
  }
  .cta-big:hover .cta-arrow {
    transform: translateX(0.15em);
  }
</style>
