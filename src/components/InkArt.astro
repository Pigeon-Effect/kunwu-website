---
/**
 * A painted ink asset (src/assets/ink/, made by `npm run ink`) – the dry brush stroke of BrushRule –
 * multiplied into the paper. Decorative unless `alt` is given. (The paintings are in Painting.astro.)
 */
import { Picture } from 'astro:assets';
import stroke from '../assets/ink/stroke.webp';

const art = { stroke };

interface Props {
  name: keyof typeof art;
  alt?: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  style?: string;
}

const { name, alt = '', sizes, widths = [320, 640, 960, 1280], eager = false, class: className = '', style } = Astro.props;
const src = art[name];
const usable = [...new Set([...widths.filter((w) => w < src.width), src.width])].sort((a, b) => a - b);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={usable}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  aria-hidden={alt ? undefined : 'true'}
  class:list={['ink', className]}
  style={style}
/>
