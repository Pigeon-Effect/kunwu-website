---
import Emblem from '../assets/brand/kunwu-emblem.svg';
import { localePath, switchLangPath, htmlLang, useT, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  route?: RouteKey | undefined;
}

const { lang, route } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'zh' : 'en';
const switchHref = switchLangPath(Astro.url.pathname, other);

const items: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.nav.home },
  { key: 'master', label: t.nav.master },
  { key: 'dailyLife', label: t.nav.dailyLife },
  { key: 'training', label: t.nav.trainingShort },
  { key: 'contact', label: t.nav.contact },
];
const current = (key: RouteKey) => (key === route ? 'page' : undefined);
const langs: { code: Lang; label: string }[] = [
  { code: 'en', label: 'EN' },
  { code: 'zh', label: '中文' },
];
---

<header class="relative z-40 bg-paper">
  <div class="wrap flex h-[4.25rem] items-center gap-4 lg:gap-8">
    <a href={localePath(lang)} class="mr-auto flex items-center gap-2.5 whitespace-nowrap no-underline">
      <Emblem width={38} height={38} aria-hidden="true" class="shrink-0" />
      <span class="font-display text-[1.2rem] text-ink" lang={htmlLang[lang]}>{t.site.name}</span>
    </a>

    <nav aria-label={t.nav.label} class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[0.95rem]">
        {
          items.map((item) => (
            <li>
              <a href={localePath(lang, item.key)} class="nav-link text-ink" aria-current={current(item.key)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Language: current one in ink, the other one a link -->
    <div class="flex items-center text-[0.9rem]">
      {
        langs.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="mx-2 h-3.5 w-px bg-gold" />}
            {l.code === lang ? (
              <span class="font-semibold text-ink" lang={htmlLang[l.code]}>
                {l.label}
              </span>
            ) : (
              <a
                href={switchHref}
                hreflang={htmlLang[l.code]}
                lang={htmlLang[l.code]}
                aria-label={t.nav.switchToLabel}
                class="text-ink-soft no-underline hover:text-vermilion"
              >
                {l.label}
              </a>
            )}
          </>
        ))
      }
    </div>

    <a href={localePath(lang, 'book')} class="btn hidden !px-4 !py-2 text-[0.92rem] sm:inline-flex" aria-current={current('book')}>
      {t.nav.book}
    </a>

    <!-- Mobile menu: native <details>, no JavaScript -->
    <details class="group lg:hidden">
      <summary class="flex list-none items-center gap-2 py-2 text-[0.92rem] [&::-webkit-details-marker]:hidden">
        <span aria-hidden="true" class="relative block h-3 w-5">
          <span class="absolute top-0 left-0 h-[1.5px] w-5 bg-ink transition group-open:top-1.5 group-open:rotate-45"></span>
          <span class="absolute top-1.5 left-0 h-[1.5px] w-5 bg-ink transition group-open:opacity-0"></span>
          <span class="absolute top-3 left-0 h-[1.5px] w-5 bg-ink transition group-open:top-1.5 group-open:-rotate-45"></span>
        </span>
        <span class="sr-only">{t.nav.menu}</span>
      </summary>
      <nav aria-label={t.nav.label} class="absolute inset-x-0 top-full bg-paper shadow-[0_18px_30px_-22px_rgb(0_0_0/0.35)]">
        <div class="fret" aria-hidden="true"></div>
        <ul class="wrap flex flex-col py-3">
          {
            items.map((item) => (
              <li>
                <a
                  href={localePath(lang, item.key)}
                  aria-current={current(item.key)}
                  class="font-display flex items-center gap-3 py-3 text-[1.6rem] no-underline aria-[current=page]:text-vermilion"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="pt-3 pb-4">
            <a href={localePath(lang, 'book')} class="btn w-full justify-center">
              {t.common.bookCta}
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
  <div class="fret" aria-hidden="true"></div>
</header>
