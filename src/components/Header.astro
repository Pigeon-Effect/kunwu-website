---
/**
 * 剔红 – the navigation bar is a panel of carved cinnabar lacquer (scripts/lacquer/lacquer.mjs → `npm run
 * lacquer`): a rounded lip, a field of 天锦 sky brocade (small diamonds, a flower raised in each), a band of
 * 回纹 key fret, lit from the upper left, casting its shadow on the paper below. The links are gold, like the
 * gold-filled inscriptions (戗金) on lacquer; Book is a raised plaque of black lacquer edged in gold; the logo
 * is a paper title slip (题签) pasted on.
 * It slides away while the page scrolls down and comes back at once when it scrolls up (Base.astro);
 * without JavaScript it simply stays.
 * Four pages + language switch + Book. Mobile: a full-screen menu from a native <details>, opening below
 * the band like the paper of the scroll – works without JavaScript.
 */
import Seal from './Seal.astro';
import Painting from './Painting.astro';
import { localePath, switchLangPath, htmlLang, useT, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  route?: RouteKey | undefined;
}

const { lang, route } = Astro.props;
const t = useT(lang);
const onHome = route === 'home';
const other: Lang = lang === 'en' ? 'zh' : 'en';
const switchHref = switchLangPath(Astro.url.pathname, other);

const items: { label: string; key: RouteKey }[] = [
  { label: t.nav.masters, key: 'master' },
  { label: t.nav.dailyLife, key: 'dailyLife' },
  { label: t.nav.programs, key: 'training' },
  { label: t.nav.contact, key: 'contact' },
];
const current = (key?: RouteKey) => (key && key === route ? 'page' : undefined);
const langs: { code: Lang; label: string }[] = [
  { code: 'en', label: 'EN' },
  { code: 'zh', label: '中文' },
];
---

<header class="site-header" data-header>
  <div class="band">
    <div class="wrap flex h-full items-center gap-5 lg:gap-9">
      <!-- 题签: the title slip, a strip of paper glued onto the silk -->
      <a href={localePath(lang)} class="title-slip mr-auto flex items-center gap-3 no-underline" aria-current={onHome ? 'page' : undefined}>
        <Seal text="坤武功夫" size="sm" />
        {
          lang === 'zh' ? (
            <span class="font-hanzi text-[1.15rem] tracking-[0.2em]">{t.site.name}</span>
          ) : (
            <span class="font-display text-[1.3rem] tracking-[0.02em]">{t.site.name}</span>
          )
        }
      </a>

      <nav aria-label={t.nav.label} class="hidden lg:block">
        <ul class="flex items-center gap-8 xl:gap-10">
          {
            items.map((item) => (
              <li>
                <a href={localePath(lang, item.key)} class="nav-link" aria-current={current(item.key)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lang hidden items-center gap-2 text-[0.8rem] tracking-[0.12em] sm:flex" role="group" aria-label={t.nav.languageLabel}>
        {
          langs.map((l, i) => (
            <>
              {i > 0 && (
                <span aria-hidden="true" class="opacity-50">
                  /
                </span>
              )}
              {l.code === lang ? (
                <span lang={htmlLang[l.code]}>{l.label}</span>
              ) : (
                <a href={switchHref} hreflang={htmlLang[l.code]} lang={htmlLang[l.code]} aria-label={t.nav.switchToLabel} class="lang-link">
                  {l.label}
                </a>
              )}
            </>
          ))
        }
      </div>

      <a href={localePath(lang, 'book')} class="plaque hidden md:inline-flex" aria-current={current('book')}>
        {t.nav.book}
      </a>

      <!-- Mobile: full-screen menu below the band -->
      <details class="menu lg:hidden" data-menu>
        <summary class="relative -mr-2 flex h-11 w-11 list-none items-center justify-center [&::-webkit-details-marker]:hidden">
          <span aria-hidden="true" class="burger"><span></span><span></span></span>
          <span class="sr-only">{t.nav.menu}</span>
        </summary>
        <div class="menu-panel">
          <Painting name="range" sizes="100vw" widths={[640, 960, 1280]} class="pointer-events-none absolute inset-x-0 bottom-0 h-auto w-full opacity-90" />
          <nav aria-label={t.nav.label} class="wrap relative flex min-h-full flex-col pt-10 pb-10">
            <ul class="flex flex-col gap-1">
              <li>
                <a href={localePath(lang)} aria-current={onHome ? 'page' : undefined} class="menu-link">
                  {t.nav.home}
                </a>
              </li>
              {
                items.map((item) => (
                  <li>
                    <a href={localePath(lang, item.key)} aria-current={current(item.key)} class="menu-link">
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="mt-auto pt-12 pb-[max(4rem,18vw)]">
              <a href={localePath(lang, 'book')} class="btn w-full">{t.common.bookCta}</a>
              <p class="mt-8 flex items-center gap-3 text-sm tracking-[0.12em]">
                <span class="text-ink-soft">{t.nav.languageLabel}</span>
                <a href={switchHref} hreflang={htmlLang[other]} lang={htmlLang[other]} aria-label={t.nav.switchToLabel}>
                  {langs.find((l) => l.code === other)?.label}
                </a>
              </p>
            </div>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    --band: 4.5rem; /* lip + field + key-fret band: the lacquer tile's full height */
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--band);
    color: var(--color-gold);
  }

  /* ------------------------------------------------ the lacquer panel */
  .band {
    position: relative;
    height: 100%;
    /* the content sits on the brocade field, between the lip (7 px) and the key-fret band (13 px) */
    padding-top: 7px;
    padding-bottom: 13px;
    background: var(--color-lacquer) url('../assets/lacquer/tihong.webp') repeat-x 0 0 / auto 100%;
    background-image: image-set(url('../assets/lacquer/tihong.avif') type('image/avif'), url('../assets/lacquer/tihong.webp') type('image/webp'));
    /* a carved panel lies on the paper: a dark contact line, then its soft shadow */
    box-shadow:
      0 1px 1px rgb(40 6 2 / 0.55),
      0 4px 6px -2px rgb(60 12 4 / 0.35),
      0 14px 22px -12px rgb(60 12 4 / 0.5);
    translate: none;
    /* back at once when scrolling up; away more slowly when scrolling down */
    transition: translate 240ms var(--ease-out-soft);
  }

  /* slides away while scrolling down; JS sets data-hidden */
  .site-header[data-hidden] .band {
    translate: 0 calc(-100% - 1.5rem);
    transition-duration: 420ms;
  }

  /* 题签 – the title slip: paper pasted onto the lacquer, its edges a little lifted */
  .title-slip {
    padding: 0.2rem 0.85rem 0.2rem 0.3rem;
    color: var(--color-ink);
    background: var(--color-paper) url('../assets/paper/rice-paper.webp') repeat 37% 61%;
    box-shadow:
      inset 0 0 0 1px rgb(60 45 25 / 0.16),
      inset 0 0 10px rgb(120 95 60 / 0.14),
      0 1px 1px rgb(30 4 0 / 0.6),
      0 2px 5px rgb(30 4 0 / 0.35);
    transition: box-shadow 250ms ease;
  }
  .title-slip:hover {
    box-shadow:
      inset 0 0 0 1px rgb(176 57 42 / 0.5),
      inset 0 0 10px rgb(120 95 60 / 0.14),
      0 1px 1px rgb(30 4 0 / 0.6),
      0 2px 5px rgb(30 4 0 / 0.35);
  }

  /* ------------------------------------------------ gold on the lacquer */
  .nav-link {
    position: relative;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 0.5rem;
    color: var(--color-gold);
    /* set into the carving: dark below, a faint glint above, a dark halo against the brocade */
    text-shadow:
      0 1px 0 rgb(35 4 1 / 0.85),
      0 -1px 0 rgb(255 210 160 / 0.12),
      0 0 6px rgb(45 6 2 / 0.7);
    transition: color 200ms ease;
  }
  :global(:lang(zh-Hans)) .nav-link {
    font-size: 0.95rem;
    letter-spacing: 0.25em;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.2em;
    bottom: 0.05rem;
    height: 1px;
    background: currentColor;
    box-shadow: 0 1px 0 rgb(35 4 1 / 0.8);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease-out-soft);
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-gold-bright);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .lang {
    text-shadow:
      0 1px 0 rgb(35 4 1 / 0.85),
      0 0 6px rgb(45 6 2 / 0.7);
  }
  .lang-link {
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 200ms ease;
  }
  .lang-link:hover {
    opacity: 1;
  }

  /* Book: a raised plaque of black lacquer, a gold fillet round its edge, its letters in gold */
  .plaque {
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.25rem;
    border-radius: 2px;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-gold-bright);
    background:
      radial-gradient(120% 90% at 30% 0%, rgb(255 235 210 / 0.1), transparent 60%),
      linear-gradient(to bottom, #2e1a15, #150a08);
    box-shadow:
      inset 0 0 0 1px rgb(214 176 104 / 0.75),
      inset 0 0 0 2.5px rgb(20 8 6 / 0.9),
      inset 0 1px 0 3px rgb(255 225 190 / 0.08),
      0 1px 0 rgb(255 170 130 / 0.18),
      0 2px 3px rgb(25 3 0 / 0.6),
      0 5px 10px -4px rgb(25 3 0 / 0.55);
    text-shadow: 0 1px 0 rgb(0 0 0 / 0.7);
    transition:
      color 200ms ease,
      box-shadow 200ms ease,
      translate 150ms ease;
  }
  .plaque:hover {
    color: #fff4da;
    box-shadow:
      inset 0 0 0 1px rgb(236 205 140 / 0.95),
      inset 0 0 0 2.5px rgb(20 8 6 / 0.9),
      inset 0 1px 0 3px rgb(255 225 190 / 0.12),
      0 1px 0 rgb(255 170 130 / 0.18),
      0 2px 3px rgb(25 3 0 / 0.6),
      0 5px 10px -4px rgb(25 3 0 / 0.55);
  }
  .plaque:active {
    translate: 0 1px;
  }
  :global(:lang(zh-Hans)) .plaque {
    font-size: 0.92rem;
    letter-spacing: 0.28em;
  }

  .band :global(:focus-visible) {
    outline-color: var(--color-gold-bright);
  }
  .menu-panel :global(:focus-visible) {
    outline-color: var(--color-vermilion);
  }

  /* ------------------------------------------------ mobile menu */
  .burger {
    position: relative;
    display: block;
    width: 1.5rem;
    height: 0.6rem;
  }
  .burger > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    box-shadow: 0 1px 0 rgb(35 4 1 / 0.85), 0 0 4px rgb(45 6 2 / 0.6);
    background: currentColor;
    transition:
      transform 300ms var(--ease-out-soft),
      top 300ms var(--ease-out-soft);
  }
  .burger > span:first-child {
    top: 0;
  }
  .burger > span:last-child {
    top: calc(100% - 1.5px);
  }
  .menu[open] .burger > span:first-child {
    top: calc(50% - 0.75px);
    transform: rotate(45deg);
  }
  .menu[open] .burger > span:last-child {
    top: calc(50% - 0.75px);
    transform: rotate(-45deg);
  }

  /* the panel unrolls below the band: the scroll's paper */
  .menu-panel {
    position: fixed;
    inset: var(--band) 0 0;
    z-index: -1;
    overflow-y: auto;
    color: var(--color-ink);
    background: var(--color-paper) url('../assets/paper/rice-paper.webp') repeat 50% 0;
  }
  .menu-link {
    display: block;
    padding-block: 0.5rem;
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1.15;
    text-decoration: none;
  }
  .menu-link[aria-current='page'] {
    color: var(--color-ink-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .menu-panel {
      animation: unroll 450ms var(--ease-out-soft);
    }
    @keyframes unroll {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }
  :global(html:has(.menu[open])) {
    overflow: hidden;
  }
</style>
