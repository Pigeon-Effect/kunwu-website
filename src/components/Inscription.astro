---
/**
 * 题款 – a short vertical inscription in regular script, signed with a seal,
 * the way classical paintings are inscribed. Columns read right to left.
 */
import Seal from './Seal.astro';

interface Props {
  /** one string per column */
  lines: string[];
  seal: string;
  size?: 'sm' | 'md';
  class?: string;
}

const { lines, seal, size = 'md', class: className = '' } = Astro.props;
---

<div class:list={['inscription', `inscription-${size}`, className]} aria-hidden="true" lang="zh-Hans">
  {
    lines.map((line, i) => (
      <div class="column">
        <span class="kai">{line}</span>
        {i === lines.length - 1 && <Seal text={seal} size="sm" class="mt-3" />}
      </div>
    ))
  }
</div>

<style>
  .inscription {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--color-ink);
  }
  .column {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .column .kai {
    writing-mode: vertical-rl;
    letter-spacing: 0.32em;
    line-height: 1;
  }
  .inscription-md .kai {
    font-size: 1.35rem;
  }
  .inscription-sm .kai {
    font-size: 1.05rem;
  }
  /* stagger the columns slightly, as a calligrapher would */
  .column + .column {
    margin-top: 1.4em;
  }
</style>
