---
/** Home page: one master – portrait, name, role, a few credentials, link to the full biography. */
import Photo from './Photo.astro';
import Seal from './Seal.astro';
import Calligraphy from './Calligraphy.astro';
import MasterPortraitPending from './MasterPortraitPending.astro';
import { masterPhoto, type Master } from '../data/masters';
import { localePath, useT, type Lang } from '../i18n/utils';

interface Props {
  master: Master;
  lang: Lang;
  /** stagger for the reveal animation */
  delay?: number;
}

const { master: m, lang, delay = 0 } = Astro.props;
const t = useT(lang);
const photo = masterPhoto(m.image);
const headingId = `card-${m.slug}`;
---

<article class="reveal" style={`--reveal-delay:${delay}ms`} aria-labelledby={headingId}>
  <div class="relative max-w-[25rem]">
    {
      photo ? (
        <Photo
          src={photo.src}
          alt={photo.alt[lang]}
          ratio="4/5"
          class="mount"
          position={m.imagePosition}
          aged
          sizes="(min-width: 48rem) 25rem, calc(100vw - 2.5rem)"
          widths={[400, 600, 800, 1000, 1400, 1800]}
        />
      ) : (
        <MasterPortraitPending master={m} lang={lang} />
      )
    }
    <Seal text={m.seal} size="md" class="absolute -right-3 -bottom-3 sm:-right-4 sm:-bottom-4" />
  </div>

  <h3 id={headingId} class="mt-10">
    <span class="sr-only" lang="zh-Hans">{m.hanzi}</span>
    <Calligraphy text={m.hanzi} vertical={false} size="3rem" delay={delay} speed={1.5} class="-ml-1" />
    <span class="mt-3 block font-display text-2xl tracking-[0.02em] text-ink" lang={lang === 'zh' ? 'zh-Latn-pinyin' : undefined}>
      {lang === 'en' ? m.name.en : m.name_pinyin}
    </span>
  </h3>
  {lang === 'en' && <p class="mt-1 text-sm tracking-[0.12em] text-ink-soft" lang="zh-Latn-pinyin">{m.name_pinyin}</p>}
  <p class="mt-5 text-ink-soft">{m.title[lang]}</p>

  <ul class="marks mt-6 space-y-0 text-[0.97rem]">
    {m.credentials[lang].map((c) => <li>{c}</li>)}
  </ul>

  <a href={localePath(lang, 'master', m.slug)} class="more mt-9">
    {t.common.readMore}<span class="sr-only">: {m.name[lang]}</span>
    <span aria-hidden="true">→</span>
  </a>
</article>
