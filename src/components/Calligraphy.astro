---
/**
 * 书法 – a title in brush calligraphy, written stroke by stroke in the correct stroke order.
 *
 * Every stroke is painted ink (scripts/ink/calligraphy.mjs → one small sprite per character in
 * src/assets/calligraphy/, layout in src/data/calligraphy.json). On the page each stroke is revealed
 * by a round brush moving along its centre line (an SVG mask), one after another, with a pause
 * between strokes and a longer one between characters.
 *
 * Writing starts when the element scrolls into view (`.write` → `.is-in`, Base.astro). Without
 * JavaScript, or with reduced motion, the characters are simply there. Decorative: the same words
 * are always present as real text (heading, label or sr-only).
 * The stroke images load when the title comes near the screen (Base.astro); `eager` for the hero.
 * New characters: add the text to scripts/ink/calligraphy.mjs and run `npm run calligraphy`.
 */
import type { ImageMetadata } from 'astro';
import data from '../data/calligraphy.json';

interface Props {
  text: string;
  /** written top to bottom (default) or left to right */
  vertical?: boolean;
  /** size of one character, any CSS length */
  size?: string;
  /** space between characters, any CSS length */
  gap?: string;
  /** ms before the first stroke */
  delay?: number;
  /** >1 writes faster */
  speed?: number;
  /** false: no writing, just the finished characters */
  animate?: boolean;
  /** load the ink right away (above the fold) instead of when it comes near */
  eager?: boolean;
  class?: string;
}

interface CharData {
  file: string;
  w: number;
  h: number;
  strokes: { x: number; y: number; w: number; h: number; sx: number; sy: number; path: string; len: number; brush: number; units: number }[];
}

const { text, vertical = true, size = '4rem', gap = '0rem', delay = 0, speed = 1, animate = true, eager = false, class: className = '' } = Astro.props;

const sprites = import.meta.glob<{ default: ImageMetadata }>('../assets/calligraphy/*.webp', { eager: true });
const chars = data as Record<string, CharData>;

// one counter per build: every instance gets its own mask ids
const g = globalThis as { __writeCount?: number };
g.__writeCount = (g.__writeCount ?? 0) + 1;
const uid = `w${g.__writeCount}`;

let clock = delay;
const written = [...text].map((ch) => {
  const c = chars[ch];
  if (!c) throw new Error(`Calligraphy: "${ch}" is not painted yet – add it to scripts/ink/calligraphy.mjs and run npm run calligraphy`);
  const src = sprites[`../assets/calligraphy/${c.file}`]?.default.src;
  const strokes = c.strokes.map((s) => {
    // the brush presses in, moves, rests: long strokes quick, short ones lingering a little
    const dur = Math.round(Math.min(900, Math.max(200, (s.units + 300) / (2.6 * speed))));
    const out = { ...s, start: clock, dur };
    clock += dur + Math.round(110 / speed);
    return out;
  });
  clock += Math.round(260 / speed);
  return { ...c, src, strokes };
});
---

<span
  class:list={['write', !animate && 'write-still', className]}
  data-vertical={vertical ? '' : undefined}
  data-lazy={eager ? undefined : ''}
  style={`--cs:${size};--cg:${gap}`}
  aria-hidden="true"
>
  {
    written.map((c, ci) => (
      <svg class="write-ch" viewBox="0 0 256 256" focusable="false">
        <defs>
          {/* the character's sprite, once; every stroke shows its own part of it */}
          {eager ? (
            <image id={`${uid}i${ci}`} href={c.src} width={c.w} height={c.h} />
          ) : (
            <image id={`${uid}i${ci}`} data-href={c.src} width={c.w} height={c.h} />
          )}
          {animate &&
            c.strokes.map((s, si) => (
              <mask id={`${uid}m${ci}-${si}`} maskUnits="userSpaceOnUse" x="-40" y="-40" width="336" height="336">
                <path
                  d={s.path}
                  pathLength="1"
                  stroke-width={s.brush}
                  style={`--d:${s.start}ms;--t:${s.dur}ms;--o:${(1 + s.brush / 1.6 / Math.max(s.len, 1)).toFixed(3)}`}
                />
              </mask>
            ))}
        </defs>
        {c.strokes.map((s, si) => (
          <g mask={animate ? `url(#${uid}m${ci}-${si})` : undefined}>
            <svg x={s.x} y={s.y} width={s.w} height={s.h} viewBox={`${s.sx} ${s.sy} ${s.w} ${s.h}`}>
              <use href={`#${uid}i${ci}`} />
            </svg>
          </g>
        ))}
      </svg>
    ))
  }
</span>

<style is:global>
  /* global (not scoped): keeps the many SVG elements free of scoping attributes */
  .write {
    display: inline-flex;
    gap: var(--cg);
    line-height: 0;
    mix-blend-mode: multiply;
  }
  .write[data-vertical] {
    flex-direction: column;
  }
  .write-ch {
    width: var(--cs);
    height: var(--cs);
    overflow: visible;
  }
  .write mask path {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 calc(var(--o) + 1);
    stroke-dashoffset: 0;
  }

  /* Writing: only with JS (the observer adds .is-in) and only when motion is welcome */
  @media (prefers-reduced-motion: no-preference) {
    .js .write:not(.write-still) mask path {
      stroke-dashoffset: var(--o);
    }
    .js .write.is-in:not(.write-still) mask path {
      /* press in, move, slow down before lifting */
      animation: write-brush var(--t) cubic-bezier(0.5, 0, 0.3, 1) var(--d) forwards;
    }
  }
  @keyframes write-brush {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
