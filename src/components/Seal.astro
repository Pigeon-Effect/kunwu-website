---
/**
 * 印章 – a vermilion seal with 1–4 characters, read top-to-bottom, right-to-left.
 * Decorative: the same words always appear as real text nearby.
 */
interface Props {
  text: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { text, size = 'md', class: className = '' } = Astro.props;
const chars = [...text];
const perColumn = chars.length <= 2 ? chars.length : 2;
const columns = Math.ceil(chars.length / perColumn);
const side = { sm: 2.4, md: 3, lg: 3.9 }[size];
const glyph = (side * 0.84) / Math.max(perColumn, columns);
---

<span
  class:list={['seal', className]}
  style={`--side:${side}rem; --glyph:${glyph}rem; --per-column:${perColumn}`}
  aria-hidden="true"
  lang="zh-Hans"
>
  <span class="seal-text">{chars.map((c) => <span>{c}</span>)}</span>
</span>

<style>
  .seal {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--side);
    height: var(--side);
    border-radius: 3px;
    background: var(--color-vermilion);
    color: var(--color-paper);
    box-shadow:
      inset 0 0 0 calc(var(--side) * 0.055) var(--color-vermilion),
      inset 0 0 0 calc(var(--side) * 0.055 + 1px) rgb(251 248 241 / 0.85);
    font-family: var(--font-kai);
    line-height: 1;
  }
  .seal-text {
    writing-mode: vertical-rl;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    inline-size: calc(var(--glyph) * var(--per-column) * 1.04);
    font-size: var(--glyph);
  }
</style>
