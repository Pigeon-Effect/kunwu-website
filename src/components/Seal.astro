---
/**
 * 印章 – an old, hand-stamped seal (see src/lib/seal.ts). Logo, masters, programs, small markers.
 * bai = characters cut out of the cinnabar block (白文), zhu = cinnabar characters in a frame (朱文).
 * Two characters make a tall seal; four make a square, read right column first.
 * Decorative: the same words always appear as real text nearby.
 */
import { sealSVG, type SealGlyphs } from '../lib/seal';
import glyphs from '../data/seal-glyphs.json';

interface Props {
  text: string;
  style?: 'bai' | 'zhu';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { text, style = 'bai', size = 'md', class: className = '' } = Astro.props;
// one counter per build: every seal on a page gets its own filter/mask ids
const g = globalThis as { __sealCount?: number };
g.__sealCount = (g.__sealCount ?? 0) + 1;
const svg = sealSVG(glyphs as unknown as SealGlyphs, { text, style, id: `seal${g.__sealCount}` })
  .replace(/ width="[\d.]+" height="[\d.]+"/, '')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const side = { xs: 2, sm: 2.6, md: 3.2, lg: 4.4, xl: 6 }[size];
---

<span class:list={['seal', className]} style={`--side:${side}rem`} lang="zh-Hans" set:html={svg} />

<style>
  .seal {
    display: inline-block;
    flex-shrink: 0;
    width: var(--side);
    line-height: 0;
    /* stamped ink sits in the paper, not on it */
    mix-blend-mode: multiply;
  }
  .seal :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
