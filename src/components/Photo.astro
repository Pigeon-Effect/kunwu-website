---
/**
 * A photo, or – while no photo exists – a clearly marked placeholder of the same shape.
 * frame: 'moon'  = 月洞门 arch with gold contour (modern photos)
 *        'print' = old paper print with caption (archival photos)
 *        'line'  = rectangle with gold contour
 *        'none'
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata | null | undefined;
  alt: string;
  /** CSS aspect ratio, e.g. "4/5"; defaults to the photo's own ratio (or 4/3 for placeholders) */
  ratio?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  frame?: 'moon' | 'print' | 'line' | 'none';
  caption?: string | undefined;
  /** Chinese caption shown next to the English one */
  captionZh?: string | undefined;
  class?: string;
}

const {
  src,
  alt,
  ratio = src ? `${src.width}/${src.height}` : '4/3',
  sizes = '(min-width: 72rem) 36rem, 100vw',
  widths = [480, 720, 960, 1280],
  eager = false,
  frame = 'none',
  caption,
  captionZh,
  class: className = '',
} = Astro.props;

const label = alt.replace(/\[PLACEHOLDER:\s*([^\]]*)\]/g, '$1');
const usableWidths = src ? [...new Set([...widths.filter((w) => w < src.width), src.width])] : [];
const shape = frame === 'moon' ? 'moon-gate' : frame === 'line' ? 'framed' : '';
---

<figure class:list={['min-w-0', frame === 'print' && 'print', className]}>
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={usableWidths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class:list={['block h-auto w-full object-cover', shape]}
        style={`aspect-ratio:${ratio}`}
      />
    ) : (
      <div class:list={['ph-photo w-full', shape]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
        <span aria-hidden="true">[PLACEHOLDER: photo – {label}]</span>
      </div>
    )
  }
  {
    (caption || captionZh) && (
      <figcaption class="flex items-baseline justify-between gap-4">
        {caption && <span>{caption}</span>}
        {captionZh && (
          <span class="kai tracking-[0.2em] text-ink" lang="zh-Hans">
            {captionZh}
          </span>
        )}
      </figcaption>
    )
  }
</figure>
