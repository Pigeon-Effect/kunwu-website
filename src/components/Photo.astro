---
/**
 * A photo, or – while no photo exists – a clearly marked placeholder of the same shape.
 * Real photos: put them in src/assets/photos/, import them and pass as `src`.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata | null | undefined;
  alt: string;
  /** CSS aspect ratio, e.g. "4/5" */
  ratio?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  ratio = '4/3',
  sizes = '(min-width: 72rem) 36rem, 100vw',
  widths = [480, 720, 960, 1280],
  eager = false,
  class: className = '',
} = Astro.props;
// An alt text that is itself still a placeholder must not be nested inside the photo placeholder.
const label = alt.replace(/\[PLACEHOLDER:\s*([^\]]*)\]/g, '$1');
---

{
  src ? (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class:list={['h-auto w-full min-w-0 object-cover', className]}
      style={`aspect-ratio:${ratio}`}
    />
  ) : (
    <div class:list={['ph-photo w-full min-w-0', className]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
      <span aria-hidden="true">[PLACEHOLDER: photo – {label}]</span>
    </div>
  )
}
