---
/**
 * Head of an inner page: section label, large title, a dry brush stroke, short lede – and the section's
 * name written in calligraphy down the right side, like the inscription on a scroll (题画). The painting is
 * the page's theme (src/data/paintings.ts). It stands left of the inscription, whole and inside the page –
 * an inscription goes in the empty paper beside a painting, never on its figures – and keeps its distance
 * from the text. Phones: the painting follows the text, right-aligned.
 */
import SectionLabel from './SectionLabel.astro';
import BrushRule from './BrushRule.astro';
import Calligraphy from './Calligraphy.astro';
import Painting from './Painting.astro';
import { sections, type SectionKey } from '../config/sections';
import type { PaintingKey } from '../data/paintings';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  section: SectionKey;
  title: string;
  lede?: string;
  art?: PaintingKey;
  /** CSS custom properties: --art-w (desktop width), --art-w-sm (phone width), --art-top */
  artStyle?: string;
}
const { lang, section, title, lede, art, artStyle } = Astro.props;
const s = sections[section];
// when the title is the section's own hanzi (师资 on /zh/master/), the title itself is written
const written = title === s.hanzi;
const sizes = '(min-width: 64rem) 24rem, (min-width: 48rem) 26vw, 72vw';
---

<header class="page-head" style={artStyle}>
  <div class="wrap pt-16 pb-14 sm:pt-24 sm:pb-20">
    <!-- one grid: wide screens  text · painting · inscription;  phones  text · inscription / painting below -->
    <div class="head-grid">
      <div class="head-text min-w-0">
        <SectionLabel as="p" decorative lang={lang} pinyin={s.pinyin} hanzi={s.hanzi} label={title} />
        {
          written ? (
            <h1 class="mt-6">
              <span class="sr-only">{title}</span>
              <Calligraphy text={title} vertical={false} size="clamp(3.6rem, 10vw, 6rem)" delay={300} eager class="-ml-2" />
            </h1>
          ) : (
            <h1 class="mt-6 max-w-4xl text-[3rem] sm:text-7xl lg:text-[5.5rem]">{title}</h1>
          )
        }
        <BrushRule align="start" class="mt-5 -ml-2" />
        {lede && <p class="mt-6 max-w-2xl text-lg text-ink-soft sm:text-xl">{lede}</p>}
      </div>
      {
        art && (
          <div class="head-art" aria-hidden="true">
            <Painting name={art} sizes={sizes} widths={[300, 450, 600, 800]} load="eager" class="block h-auto w-full" />
          </div>
        )
      }
      {!written && <Calligraphy text={s.hanzi} size="clamp(3rem, 8vw, 5.6rem)" gap="-0.04em" delay={300} eager class="head-callig" />}
    </div>
    <slot />
  </div>
</header>

<style>
  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'text callig'
      'art art';
    align-items: start;
  }
  .head-text {
    grid-area: text;
    padding-right: 1.5rem;
  }
  :global(.head-callig) {
    grid-area: callig;
  }
  /* phones: the painting follows the text, right-aligned */
  .head-art {
    grid-area: art;
    justify-self: end;
    width: var(--art-w-sm, 72vw);
    margin: 2rem -0.5rem 0 0;
  }
  /* wider: the painting stands left of the inscription, top aligned with the label, clear of the text */
  @media (min-width: 48rem) {
    .head-grid {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'text art callig';
    }
    .head-text {
      padding-right: 3rem;
    }
    .head-art {
      justify-self: auto;
      width: var(--art-w, clamp(13rem, 26vw, 24rem));
      margin: var(--art-top, 0rem) 1rem 0 0;
    }
    :global(.head-callig) {
      margin-right: 3%;
    }
  }
  @media (min-width: 64rem) {
    .head-art {
      margin-right: 1.5rem;
    }
  }
</style>
