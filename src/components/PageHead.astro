---
/**
 * Head of an inner page: section label, large title, a dry brush stroke, short lede – and the section's
 * name written in calligraphy down the right side, like the inscription on a scroll (题画). The painting is
 * the page's theme (src/data/paintings.ts). An inscription belongs in the empty part of a painting, so:
 *   artMode 'beside'  the painting stands left of the inscription (figures, animals – things to keep clear)
 *   artMode 'behind'  the painting lies under the inscription, bleeding off the page's edge (a pine bough
 *                     with open space between its needles); placed with --art-w, --art-top, --art-right
 * Phones: the painting follows the text, right-aligned.
 */
import SectionLabel from './SectionLabel.astro';
import BrushRule from './BrushRule.astro';
import Calligraphy from './Calligraphy.astro';
import Painting from './Painting.astro';
import { sections, type SectionKey } from '../config/sections';
import type { PaintingKey } from '../data/paintings';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  section: SectionKey;
  title: string;
  lede?: string;
  art?: PaintingKey;
  artMode?: 'beside' | 'behind';
  /** CSS custom properties: --art-w (desktop width), --art-w-sm (phone width), --art-top, --art-right */
  artStyle?: string;
}
const { lang, section, title, lede, art, artMode = 'beside', artStyle } = Astro.props;
const s = sections[section];
// when the title is the section's own hanzi (师资 on /zh/master/), the title itself is written
const written = title === s.hanzi;
const sizes = artMode === 'behind' ? '(min-width: 48rem) 40vw, 46vw' : '(min-width: 64rem) 24rem, (min-width: 48rem) 26vw, 62vw';
---

<header class="page-head relative isolate" data-art={art ? artMode : undefined} style={artStyle}>
  {
    art && artMode === 'behind' && (
      <div class="art-behind" aria-hidden="true">
        <Painting name={art} sizes={sizes} widths={[360, 540, 720, 960]} load="eager" class="block h-auto w-full" />
      </div>
    )
  }
  <div class="wrap relative pt-16 pb-14 sm:pt-24 sm:pb-20">
    <div class="flex items-start justify-between gap-6">
      <div class="min-w-0 flex-1">
        <SectionLabel as="p" decorative lang={lang} pinyin={s.pinyin} hanzi={s.hanzi} label={title} />
        {
          written ? (
            <h1 class="mt-6">
              <span class="sr-only">{title}</span>
              <Calligraphy text={title} vertical={false} size="clamp(3.6rem, 10vw, 6rem)" delay={300} eager class="-ml-2" />
            </h1>
          ) : (
            <h1 class="mt-6 max-w-4xl text-[3rem] sm:text-7xl lg:text-[5.5rem]">{title}</h1>
          )
        }
        <BrushRule align="start" class="mt-5 -ml-2" />
        {lede && <p class="mt-6 max-w-2xl text-lg text-ink-soft sm:text-xl">{lede}</p>}
      </div>
      <div class="flex shrink-0 items-start gap-2 sm:mr-[3%] lg:gap-4">
        {
          art && artMode === 'beside' && (
            <div class="art-beside hidden md:block" aria-hidden="true">
              <Painting name={art} sizes={sizes} widths={[300, 450, 600, 800]} load="lazy" class="block h-auto w-full" />
            </div>
          )
        }
        {!written && <Calligraphy text={s.hanzi} size="clamp(3rem, 8vw, 5.6rem)" gap="-0.04em" delay={300} eager class="shrink-0" />}
      </div>
    </div>
    {
      art && artMode === 'beside' && (
        <div class="art-below md:hidden" aria-hidden="true">
          <Painting name={art} sizes={sizes} widths={[300, 450, 600, 800]} load="lazy" class="block h-auto w-full" />
        </div>
      )
    }
    <slot />
  </div>
</header>

<style>
  /* beside the inscription: in the flow, top aligned with the label */
  .art-beside {
    width: var(--art-w, clamp(13rem, 26vw, 24rem));
    margin-top: var(--art-top, 0rem);
  }
  .art-below {
    width: var(--art-w-sm, 72vw);
    margin: 2rem -0.5rem 0 auto;
  }

  /* behind the inscription: top right, bleeding off the page's edge */
  .art-behind {
    position: absolute;
    z-index: -1;
    top: var(--art-top, 0.5rem);
    right: var(--art-right, -1rem);
    width: var(--art-w, min(46vw, 36rem));
    pointer-events: none;
  }
  @media (max-width: 47.99rem) {
    .art-behind {
      top: -0.5rem;
      right: -1.75rem;
      width: var(--art-w-sm, 52vw);
      opacity: 0.6;
    }
  }
</style>
