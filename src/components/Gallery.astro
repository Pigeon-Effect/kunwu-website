---
/**
 * Justified photo grid, CSS only: every photo keeps its own aspect ratio and grows in proportion
 * to it, so each row fills the width at roughly the same height. Rows stay low (the photos are
 * soft – see images.todo.md), all photos lazy-load with the aged treatment.
 */
import Photo from './Photo.astro';
import { photos, type PhotoId } from '../data/photos';
import type { Lang } from '../i18n/utils';

interface Props {
  ids: PhotoId[];
  lang: Lang;
}
const { ids, lang } = Astro.props;
const items = ids.map((id) => {
  const p = photos[id];
  return { id, p, ar: p.src.width / p.src.height };
});
---

<ul class="gallery" role="list">
  {
    items.map(({ id, p, ar }) => (
      <li style={`--ar:${ar.toFixed(4)}`} data-photo={id}>
        <Photo
          src={p.src}
          alt={p.alt[lang]}
          aged
          wash={0.08}
          ratio={`${p.src.width}/${p.src.height}`}
          sizes={`(min-width: 64rem) calc(15rem * ${ar.toFixed(3)}), calc(10rem * ${ar.toFixed(3)})`}
          widths={[240, 360, 480, 720, 960]}
        />
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    --row: 10rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 40rem) {
    .gallery {
      --row: 12.5rem;
      gap: 0.75rem;
    }
  }
  @media (min-width: 64rem) {
    .gallery {
      --row: 15rem;
    }
  }
  .gallery > li {
    flex: var(--ar) 1 calc(var(--ar) * var(--row));
    min-width: 0;
  }
  /* keeps the last row from stretching */
  .gallery::after {
    content: '';
    flex: 999 1 0;
  }
</style>
