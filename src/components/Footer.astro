---
import Seal from './Seal.astro';
import InkArt from './InkArt.astro';
import { address } from '../config/site';
import { localePath, useT, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const pages: { key: RouteKey; label: string }[] = [
  { key: 'master', label: t.nav.masters },
  { key: 'dailyLife', label: t.nav.dailyLife },
  { key: 'training', label: t.nav.training },
  { key: 'book', label: t.nav.book },
  { key: 'contact', label: t.nav.contact },
];
const year = new Date().getFullYear();
const otherName = lang === 'en' ? '坤武功夫国际交流中心' : 'Kunwu International Kung Fu Training Center';
---

<footer class="mt-auto">
  <!-- distant peaks above the footer, as on the edge of a scroll -->
  <InkArt name="mountainsStrip" sizes="100vw" widths={[640, 960, 1280, 1600]} class="block h-auto w-full opacity-90" />
  <div class="wrap grid gap-10 py-14 text-sm md:grid-cols-[1.4fr_1fr] md:items-start">
    <div class="flex items-start gap-4">
      <Seal text="坤武" style="zhu" size="sm" />
      <div>
        <p class="text-ink">{t.site.fullName}</p>
        <p class="mt-1 text-ink-soft" lang={lang === 'en' ? 'zh-Hans' : 'en'}>{otherName}</p>
        <p class="mt-3 text-ink-soft">{(lang === 'zh' ? address.zhLines : address.enLines).slice(-2).join(lang === 'zh' ? '' : ', ')}</p>
      </div>
    </div>

    <nav aria-label={t.footer.pages}>
      <ul class="flex flex-wrap gap-x-7 gap-y-2 md:justify-end">
        {
          pages.map((p) => (
            <li>
              <a href={localePath(lang, p.key)} class="text-ink-soft no-underline transition-colors hover:text-ink">
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap pb-10">
    <p class="text-xs text-ink-soft">© {year} {t.site.fullName}. {t.footer.rights}</p>
  </div>
</footer>
